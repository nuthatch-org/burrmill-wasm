{
  "cleanUrls": false,
  "headers": [
    { "source": "/pkg/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }] },
    { "source": "/timelapse/pkg/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }] },
    { "source": "/live/pkg/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }] },
    { "source": "/live/(sw|nest-worker|page|live)\\.js", "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
